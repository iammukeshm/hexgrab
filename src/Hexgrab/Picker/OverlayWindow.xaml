<Window x:Class="Hexgrab.Picker.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Focusable="False">
    <Border Background="#1E1E1E"
            BorderBrush="#3C3C3C"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,6">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Swatch"
                    Width="26"
                    Height="26"
                    CornerRadius="5"
                    BorderBrush="#5A5A5A"
                    BorderThickness="1"
                    Background="Black" />
            <TextBlock x:Name="HexText"
                       Margin="10,0,2,0"
                       VerticalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="15"
                       Foreground="#F2F2F2"
                       Text="#000000" />
        </StackPanel>
    </Border>
</Window>
